<Window x:Class="AvtomatChat.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Закрыть AvtomatChat?" Height="200" Width="420"
        Icon="icon.ico"
        ResizeMode="NoResize"
        Background="#FF18181B"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00E701"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFEFEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADADB8"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E2E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Главная кнопка (рекомендуемое действие) — зелёная -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF0E0E10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF00B701"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#FF141417">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="Закрыть AvtomatChat?" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,12">
            <TextBlock TextWrapping="Wrap"
                       Text="Ты подключен к чату. Свернуть приложение в трей (чат, озвучка и OBS-оверлей продолжат работать) или выйти полностью?"/>
            <CheckBox x:Name="RememberCheck" Content="Запомнить выбор (изменить можно в настройках)"
                      Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" Click="Cancel_Click"/>
                <Button Content="Выйти" Margin="8,0,0,0" Click="Exit_Click"/>
                <Button Content="Свернуть в трей" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="Tray_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
