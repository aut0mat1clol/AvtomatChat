<Window x:Class="AvtomatChat.CssHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Справка по CSS — AvtomatChat" Height="620" Width="560"
        Icon="icon.ico"
        MinHeight="360" MinWidth="440"
        Background="#FF18181B"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00E701"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFEFEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADADB8"/>
        <SolidColorBrush x:Key="CodeBrush" Color="#FF6CB9FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Заголовок секции -->
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- Строка «класс — описание» -->
        <Style x:Key="ClassName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource CodeBrush}"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ClassDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF141417">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="Справка по CSS оверлея" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Закрыть"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="Структура сообщения"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="сообщение целиком (фон, отступы, шрифт)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg .nick"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="ник автора"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg .time"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="отметка времени (только окно приложения)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg img.emote"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="эмоут (Twitch / 7TV)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg img.badge"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="значок перед ником (модер, VIP, саб…)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg a.link"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="ссылка (сокращённая)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg img.linkpreview"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="миниатюра картинки по ссылке"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Типы сообщений"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.alert"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="алерт: саб, рейд, стрик, фолов, шаутаут"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.highlighted"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="«Выделить моё сообщение» за баллы канала"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.sysmsg"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="системное: зашёл/вышел из чата"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg .me"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="сообщение /me (курсив в цвете ника)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg .translation"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="строка перевода (только окно приложения)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.deleted-full"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="удалённое модератором (только окно приложения; в OBS удалённые не показываются)"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Анимации"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.appearing"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="появление нового сообщения (плавный въезд)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Style="{StaticResource ClassName}" Text=".msg.collapsing"/>
                    <TextBlock Style="{StaticResource ClassDesc}" Text="исчезание (fade-таймер, удаление) — затухание и схлопывание"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Примеры"/>
                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Background="#FF141417" Foreground="#FFDCDCDC" BorderThickness="0"
                         Padding="10" TextWrapping="Wrap"
                         Text="/* свой шрифт (любой установленный в Windows) */&#10;.msg { font-family: 'Comic Sans MS'; font-size: 22px; }&#10;&#10;/* веб-шрифт — @import строго в начале CSS */&#10;@import url('https://fonts.googleapis.com/css2?family=Rubik&amp;display=swap');&#10;.msg { font-family: 'Rubik'; }&#10;&#10;/* ники капсом, алерты крупнее */&#10;.msg .nick { text-transform: uppercase; }&#10;.msg.alert { font-size: 1.2em; }&#10;&#10;/* эмоуты и значки побольше */&#10;.msg img.emote { height: 34px; }&#10;.msg img.badge { height: 22px; }"/>

                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="После изменения CSS: в OBS — свойства источника → «Обновить кэш текущей страницы». Окно приложения обновляется само."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
