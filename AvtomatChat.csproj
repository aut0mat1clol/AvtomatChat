<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AvtomatChat</AssemblyName>
    <RootNamespace>AvtomatChat</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Версия приложения: должна совпадать с тегом релиза на GitHub -->
    <Version>1.5.1</Version>
    <!-- Нативные библиотеки (WebView2Loader.dll) — внутрь единого exe,
         иначе single-file сборка падает с 'Unable to load DLL WebView2Loader.dll' -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Speech для .NET (Core/5+). Работает только на Windows. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- Встроенный браузер для предпросмотра оверлея (тот же Chromium, что в OBS) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
