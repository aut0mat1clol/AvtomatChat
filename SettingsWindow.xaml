<Window x:Class="AvtomatChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки — AvtomatChat" Height="600" Width="720"
        Icon="icon.ico"
        MinHeight="420" MinWidth="560"
        Background="#FF18181B"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1F1F23"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00E701"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF00B701"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFEFEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADADB8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF0E0E10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                                <Setter Property="Foreground" Value="#FF77777D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2E2E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3D"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Пункт бокового меню разделов -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="12,8" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E2E35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E2E35"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#FF141417">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="Настройки" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Закрыть"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню разделов -->
            <Border Grid.Column="0" Background="#FF141417" Padding="8">
                <StackPanel>
                    <RadioButton x:Name="NavTts" Style="{StaticResource NavButton}" Content="🔊 Озвучка"
                                 IsChecked="True" Checked="Nav_Checked" Tag="Tts"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="🔔 Алерты и события"
                                 Checked="Nav_Checked" Tag="Alerts"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="🎨 Оверлей"
                                 Checked="Nav_Checked" Tag="Overlay"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="👤 Аккаунт"
                                 Checked="Nav_Checked" Tag="Account"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="🔄 Обновления"
                                 Checked="Nav_Checked" Tag="Updates"/>
                </StackPanel>
            </Border>

            <!-- Содержимое раздела -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <Grid>
                    <!-- ===== Озвучка ===== -->
                    <StackPanel x:Name="PageTts">
                        <TextBlock Text="Озвучка (TTS)" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="TtsEnabledCheck" Content="Включить озвучку"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SpeakNameCheck" Content="Произносить ник"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SkipCommandsCheck" Content="Пропускать !команды"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="StripLinksCheck" Content="Не читать ссылки"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SkipEmotesCheck" Content="Не читать эмоуты"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Не произносить названия эмоутов Twitch/7TV"/>

                        <CheckBox x:Name="TriggerCheck" Content="Озвучивать только с триггером"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Читать только сообщения, содержащие слово-триггер"/>
                        <TextBox x:Name="TriggerBox" Margin="0,2,0,0"
                                 TextChanged="Setting_Changed_Text"
                                 ToolTip="Слово или символы, при наличии которых сообщение будет озвучено (само слово не читается)"/>

                        <TextBlock Text="Не озвучивать пользователей:" Style="{StaticResource SubTitle}"/>
                        <TextBox x:Name="IgnoredUsersBox" TextWrapping="Wrap" AcceptsReturn="False"
                                 MinHeight="44" VerticalScrollBarVisibility="Auto"
                                 TextChanged="Setting_Changed_Text"
                                 ToolTip="Имена через запятую (регистр не важен). Их сообщения не озвучиваются, но видны в чате и OBS."/>

                        <TextBlock Text="Куда выводить звук:" Style="{StaticResource SubTitle}"/>
                        <CheckBox x:Name="PlayLocalCheck" Content="На этом ПК"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="PlayObsCheck" Content="В OBS (через оверлей)"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Звук пойдёт из браузерного источника OBS — попадёт в микс стрима"/>

                        <TextBlock Text="Голос:" Style="{StaticResource SubTitle}"/>
                        <ComboBox x:Name="VoiceCombo" SelectionChanged="Setting_Changed_Sel">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#FF0E0E10"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Style="{StaticResource SubTitle}">
                            <Run Text="Скорость: "/><Run x:Name="RateLabel" Text="0"/>
                        </TextBlock>
                        <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="RateSlider_ValueChanged"/>

                        <TextBlock Style="{StaticResource SubTitle}">
                            <Run Text="Громкость: "/><Run x:Name="VolumeLabel" Text="100"/>
                        </TextBlock>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <Button Content="Тест голоса" Margin="0,12,0,4" HorizontalAlignment="Left"
                                Click="TestButton_Click"/>
                    </StackPanel>

                    <!-- ===== Алерты и события ===== -->
                    <StackPanel x:Name="PageAlerts" Visibility="Collapsed">
                        <TextBlock Text="Алерты и события" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="ShowAlertsCheck" Content="Показывать алерты (сабы, рейды, стрики)"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SpeakAlertsCheck" Content="Озвучивать алерты"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <TextBlock Text="Фоловы и шаутауты показываются после входа в аккаунт (раздел «Аккаунт»)."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Text="События чата:" Style="{StaticResource SubTitle}"/>
                        <CheckBox x:Name="ShowJoinsLocalCheck" Content="Показывать, кто зашёл/вышел (в приложении)"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Twitch присылает эти события пачками с задержкой до минуты"/>
                        <CheckBox x:Name="ShowJoinsObsCheck" Content="… и в OBS-оверлее"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="TranslateCheck" Content="Переводить английские сообщения"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Перевод EN→RU показывается серым под сообщением — только в окне приложения. Нужен интернет."/>

                        <TextBlock Text="При закрытии окна (если подключен к чату):" Style="{StaticResource SubTitle}"/>
                        <ComboBox x:Name="CloseBehaviorCombo" SelectionChanged="Setting_Changed_Sel">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#FF0E0E10"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Спрашивать</system:String>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Сворачивать в трей</system:String>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Выходить</system:String>
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>

                    <!-- ===== Оверлей ===== -->
                    <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                        <TextBlock Text="OBS-оверлей" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Адрес для источника «Браузер» в OBS:" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="ObsUrlBox" IsReadOnly="True" Margin="0,4,0,0"/>

                        <TextBlock Text="Пресет лайаута:" Style="{StaticResource SubTitle}"/>
                        <ComboBox x:Name="PresetCombo" SelectionChanged="Setting_Changed_Sel">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Foreground="#FF0E0E10"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox x:Name="LinkPreviewsCheck" Content="Предпросмотр картинок по ссылкам"
                                  Margin="0,8,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  ToolTip="Ссылки на png/jpg/gif/webp показываются миниатюрой в чате и оверлее"/>

                        <TextBlock Text="Чьи ссылки показывать картинкой:" Style="{StaticResource SubTitle}"/>
                        <ComboBox x:Name="PreviewModeCombo" SelectionChanged="Setting_Changed_Sel"
                                  ToolTip="Защита от вброса непотребных картинок на стрим: превью только от доверенных зрителей">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#FF0E0E10"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Items>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Всех зрителей</system:String>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Модеров, VIP и белого списка</system:String>
                                <system:String xmlns:system="clr-namespace:System;assembly=System.Runtime">Только белого списка</system:String>
                            </ComboBox.Items>
                        </ComboBox>

                        <TextBlock Text="Белый список для превью:" Style="{StaticResource SubTitle}"/>
                        <TextBox x:Name="PreviewWhitelistBox" TextWrapping="Wrap" AcceptsReturn="False"
                                 MinHeight="44" VerticalScrollBarVisibility="Auto"
                                 TextChanged="Setting_Changed_Text"
                                 ToolTip="Ники через запятую (регистр не важен). Их ссылки показываются картинкой; у остальных остаются обычной ссылкой. Стример доверен всегда."/>

                        <TextBlock Style="{StaticResource SubTitle}">
                            <Run Text="Исчезание сообщений в OBS: "/><Run x:Name="FadeLabel" Text="выкл"/>
                        </TextBlock>
                        <Slider x:Name="FadeSlider" Minimum="0" Maximum="120" Value="0"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="FadeSlider_ValueChanged"
                                ToolTip="Через сколько секунд сообщение пропадает из OBS-оверлея (0 — никогда)"/>

                        <TextBlock Text="Свой CSS (добавляется к пресету):" Style="{StaticResource SubTitle}"/>
                        <TextBox x:Name="CustomCssBox" MinHeight="90" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 TextChanged="Setting_Changed_Text"/>
                        <Button Content="Справка по CSS" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Click="CssHelpButton_Click"
                                ToolTip="Все классы оверлея с описаниями и примерами"/>
                    </StackPanel>

                    <!-- ===== Аккаунт ===== -->
                    <StackPanel x:Name="PageAccount" Visibility="Collapsed">
                        <TextBlock Text="Twitch-аккаунт" Style="{StaticResource SectionTitle}"/>

                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Вход не обязателен: чат, эмоуты, алерты сабов и рейдов работают без него. Авторизация добавляет:"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="💚 алерты фоловов&#10;📣 алерты шаутаутов (/shoutout)&#10;🛡 канальные саб- и bits-бейджи"/>

                        <TextBlock x:Name="AccountStatus" Margin="0,14,0,0" FontWeight="SemiBold"
                                   Text="Не авторизован"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="TwitchLoginButton" Content="Войти через Twitch"
                                    Click="TwitchLoginButton_Click"/>
                            <Button x:Name="TwitchLogoutButton" Content="Выйти" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="TwitchLogoutButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="Вход подтверждается на официальной странице twitch.tv — пароль приложение не видит. Войти нужно аккаунтом стримера или модератора канала."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- ===== Обновления ===== -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <TextBlock Text="Обновления" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="AutoUpdateCheck" Content="Проверять обновления при запуске"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <Button Content="Проверить сейчас" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Click="CheckUpdatesButton_Click"
                                ToolTip="Результат — в статусной строке главного окна"/>
                        <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
