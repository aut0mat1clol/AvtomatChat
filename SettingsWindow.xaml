<Window x:Class="AvtomatChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки — AvtomatChat" Height="640" Width="480"
        Icon="icon.ico"
        MinHeight="400" MinWidth="380"
        Background="#FF18181B"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1F1F23"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00E701"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF00B701"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFEFEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADADB8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF0E0E10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                                <Setter Property="Foreground" Value="#FF77777D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2E2E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3D"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#FF3A3A3D"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Grid Grid.Row="0" Background="#FF141417">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="Настройки" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Закрыть"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
            <StackPanel x:Name="RootPanel">

                <TextBlock Text="Озвучка (TTS)" FontSize="16" FontWeight="Bold" Margin="0,4,0,8"/>

                <CheckBox x:Name="TtsEnabledCheck" Content="Включить озвучку"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="SpeakNameCheck" Content="Произносить ник"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="SkipCommandsCheck" Content="Пропускать !команды"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="StripLinksCheck" Content="Не читать ссылки"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="SkipEmotesCheck" Content="Не читать эмоуты"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Не произносить названия эмоутов 7TV"/>

                <CheckBox x:Name="TriggerCheck" Content="Озвучивать только с триггером"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Читать только сообщения, содержащие слово-триггер"/>
                <TextBox x:Name="TriggerBox" Margin="0,2,0,0"
                         TextChanged="TriggerBox_TextChanged"
                         ToolTip="Слово или символы, при наличии которых сообщение будет озвучено (само слово не читается)"/>

                <TextBlock Text="Не озвучивать пользователей:" Margin="0,10,0,2"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="IgnoredUsersBox" Margin="0,2,0,0"
                         TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="IgnoredUsersBox_TextChanged"
                         ToolTip="Имена через запятую (регистр не важен). Их сообщения не будут озвучиваться, но останутся видны в чате и OBS."/>

                <TextBlock Text="Куда выводить звук:" Margin="0,10,0,2" Foreground="{StaticResource MutedBrush}"/>
                <CheckBox x:Name="PlayLocalCheck" Content="На этом ПК"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Проигрывать озвучку через динамики этого компьютера"/>
                <CheckBox x:Name="PlayObsCheck" Content="В OBS (через оверлей)"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Звук пойдёт из браузерного источника OBS — попадёт в микс стрима"/>

                <TextBlock Text="Голос:" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="VoiceCombo" SelectionChanged="VoiceCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#FF0E0E10"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Скорость: "/><Run x:Name="RateLabel" Text="0"/>
                </TextBlock>
                <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="RateSlider_ValueChanged"/>

                <TextBlock Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Громкость: "/><Run x:Name="VolumeLabel" Text="100"/>
                </TextBlock>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged"/>

                <Button Content="Тест голоса" Margin="0,10,0,0" Click="TestButton_Click"/>

                <Separator/>

                <TextBlock Text="События чата" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowJoinsLocalCheck" Content="Показывать, кто зашёл/вышел (в приложении)"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Серые строки «зашёл в чат»/«вышел из чата». Внимание: Twitch присылает эти события пачками с задержкой до минуты, а на больших каналах — не для всех."/>
                <CheckBox x:Name="ShowJoinsObsCheck" Content="… и в OBS-оверлее"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Дополнительно выводить события входа/выхода в оверлей OBS"/>

                <Separator/>

                <TextBlock Text="OBS-оверлей" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ObsCheck" Content="Включить сервер для OBS"
                          Checked="ObsCheck_Changed" Unchecked="ObsCheck_Changed"/>
                <TextBox x:Name="ObsUrlBox" IsReadOnly="True" Margin="0,4,0,0"
                         ToolTip="Скопируй этот адрес в источник «Браузер» в OBS"/>
                <TextBlock Text="OBS → Источники → Браузер → вставь адрес выше"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <Separator/>

                <TextBlock Text="Алерты" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowAlertsCheck" Content="Показывать алерты (сабы, рейды)"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Подписки, ресабы, подарочные сабы и рейды из чата — без авторизации"/>
                <CheckBox x:Name="SpeakAlertsCheck" Content="Озвучивать алерты"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                <Separator/>

                <TextBlock Text="Лайаут OBS-оверлея" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Пресет:" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="PresetCombo" Margin="0,4,0,0" SelectionChanged="Setting_Changed_Sel">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="#FF0E0E10"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Свой CSS (добавляется к пресету):" Margin="0,10,0,2"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="CustomCssBox" MinHeight="80" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         TextChanged="Setting_Changed_Text"
                         ToolTip="Например: .msg { font-family: 'Comic Sans MS'; } .msg .nick { text-transform: uppercase; }"/>
                <TextBlock Text="Классы: .msg — сообщение, .msg .nick — ник, .msg img.emote — эмоут, .msg.alert — алерт, .msg.sysmsg — зашёл/вышел. Изменения видны после обновления кэша источника в OBS."
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <Separator/>

                <TextBlock Text="Обновления" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoUpdateCheck" Content="Проверять обновления при запуске"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Проверка через GitHub Releases. Если найдена новая версия — в главном окне появится баннер с кнопкой обновления."/>
                <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
