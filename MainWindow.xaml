<Window x:Class="AvtomatChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AvtomatChat"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AvtomatChat" Height="620" Width="860"
        Icon="icon.ico"
        MinHeight="420" MinWidth="640"
        Background="#FF18181B"
        WindowStyle="None"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <!-- Кастомная рамка окна: своя шапка вместо системной -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1F1F23"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00E701"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF00B701"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFEFEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADADB8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF0E0E10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                                <Setter Property="Foreground" Value="#FF77777D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки шапки окна (свернуть/развернуть/закрыть) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2E2E35"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2E2E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3D"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <!-- RootGrid: шапка + содержимое; отступ добавляется при разворачивании -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Grid Grid.Row="0" Background="#FF141417">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="AvtomatChat" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="Minimize_Click" ToolTip="Свернуть"/>
                <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="MaxRestore_Click" ToolTip="Развернуть"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        Click="CloseWindow_Click" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <!-- Содержимое -->
        <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель подключения -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Канал:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="⚙ Настройки" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Click="SettingsButton_Click"/>
                <Button x:Name="ConnectButton" Content="Подключиться" DockPanel.Dock="Right"
                        Margin="8,0,0,0" Click="ConnectButton_Click"/>
                <TextBox x:Name="ChannelBox" VerticalAlignment="Center"
                         KeyDown="ChannelBox_KeyDown"
                         ToolTip="Имя канала Twitch, например: lirik"/>
            </DockPanel>
        </Border>

        <!-- Баннер обновления (скрыт, пока нет новой версии) -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#FF1F3D1F" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="UpdateButton" Content="Обновить и перезапустить" DockPanel.Dock="Right"
                        Padding="10,3" Click="UpdateButton_Click"/>
                <TextBlock x:Name="UpdateLabel" VerticalAlignment="Center"
                           Text="Доступна новая версия"/>
            </DockPanel>
        </Border>

        <!-- Список сообщений -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                CornerRadius="6" Padding="4">
            <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseWheel="ChatList_PreviewMouseWheel"
                     ToolTip="Ctrl + колесо мыши — масштаб чата, Ctrl+0 — сброс">
                <ListBox.LayoutTransform>
                    <ScaleTransform x:Name="ChatZoomTransform" ScaleX="1" ScaleY="1"/>
                </ListBox.LayoutTransform>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChatMessage}">
                        <!-- MessageRenderer строит время + ник + текст с эмоутами 7TV -->
                        <TextBlock TextWrapping="Wrap" Foreground="#FFEFEFF1"
                                   local:MessageRenderer.Message="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Кнопки TTS под чатом -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Пропустить" Margin="8,0,0,0" Padding="10,3" Click="SkipButton_Click"
                            ToolTip="Пропустить текущее озвучиваемое сообщение"/>
                    <Button Content="Очистить очередь" Margin="8,0,0,0" Padding="10,3" Click="ClearQueueButton_Click"/>
                    <Button Content="Очистить чат" Margin="8,0,0,0" Padding="10,3" Click="ClearChatButton_Click"
                            ToolTip="Убрать все сообщения из окна и OBS-оверлея"/>
                    <TextBlock x:Name="QueueLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedBrush}" Text="В очереди: 0"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="Не подключено" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
